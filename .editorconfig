root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_width = 2

[*.{ts,js,json,jsonc}]
indent_style = space
indent_width = 2

[*.{yml,yaml}]
indent_style = space
indent_width = 2

[*.md]
trim_trailing_whitespace = false

