{
  "name": "@slashlab/numerik-js",
  "version": "0.1.0",
  "description": "Validate and parse Polish identification numbers: PESEL, NIP, REGON, KRS, NRB, IBAN, VAT-EU, ID card, and passport",
  "author": {
    "name": "Sqrcz",
    "url": "https://github.com/sqrcz"
  },
  "homepage": "https://github.com/sqrcz/numerik-js#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sqrcz/numerik-js.git"
  },
  "bugs": {
    "url": "https://github.com/sqrcz/numerik-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod/index.d.ts",
        "default": "./dist/zod/index.js"
      },
      "require": {
        "types": "./dist/zod/index.d.cts",
        "default": "./dist/zod/index.cjs"
      }
    }
  },
  "peerDependencies": {
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cover": "vitest run --coverage",
    "test:types": "vitest run --typecheck --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:types"
  },
  "keywords": [
    "iban",
    "id-card",
    "krs",
    "nip",
    "nrb",
    "numerik",
    "passport",
    "pesel",
    "poland",
    "polish",
    "regon",
    "typescript",
    "validation",
    "validator",
    "vat-eu"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@vitest/coverage-v8": "^4.1.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  }
}
