{
  "name": "@slashlab/numerik-js",
  "version": "0.1.0",
  "description": "Validate and parse Polish identification numbers: PESEL, NIP, REGON, KRS, NRB, IBAN, VAT-EU, ID card, and passport",
  "author": {
    "name": "Sqrcz",
    "url": "https://github.com/sqrcz"
  },
  "homepage": "https://github.com/sqrcz/numerik-js#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sqrcz/numerik-js.git"
  },
  "bugs": {
    "url": "https://github.com/sqrcz/numerik-js/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cover": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check": "pnpm typecheck && pnpm test"
  },
  "keywords": [
    "iban",
    "id-card",
    "krs",
    "nip",
    "nrb",
    "numerik",
    "passport",
    "pesel",
    "poland",
    "polish",
    "regon",
    "typescript",
    "validation",
    "validator",
    "vat-eu"
  ],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
